# Copy to .env.local for local runs; add the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # secret; never put this in browser code

# Meta → WhatsApp → API Setup
WA_TOKEN=EAAG...                            # access token (temporary for testing, permanent System User token for live)
WA_VERIFY_TOKEN=pick-any-long-random-text   # you invent this; type the same text in Meta's webhook setup
WA_APP_SECRET=                              # Meta app → Settings → Basic → App secret (checks messages really come from Meta)
WA_GRAPH_VERSION=v23.0                      # use the version shown in Meta's API Setup sample code

# Reminders
WA_REMINDER_TEMPLATE=booking_reminder
WA_TEMPLATE_LANG=en
CRON_SECRET=pick-another-long-random-text
